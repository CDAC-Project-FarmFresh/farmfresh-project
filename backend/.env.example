# Copy to ".env" in this directory (next to pom.xml and run.sh) and fill in real values.
# run.sh loads .env automatically. Do not commit .env (see repo-root .gitignore).

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/farmfresh?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=manager

# --- JWT (use a long random string in production; min 32 bytes for HS256) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars-for-production-use-openssl-rand-hex-32
JWT_ACCESS_MS=86400000
JWT_REFRESH_MS=604800000

# --- CORS & frontend (password reset / phone OTP email links) ---
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:5173

# --- Outbound email (optional; if username empty, reset/OTP are logged only) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- HTTP server (Spring Boot) ---
SERVER_PORT=8080

# --- Maven (optional; used by run.sh) ---
# SKIP_TESTS=true   # when set to "true", run.sh uses -DskipTests for package/install/jar
